# Controller project source is intentionally kept visible to Git:
# controller_agent/, scripts/, selected architecture docs, and tests.

# Local Python environments and caches
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example

# External AppWorld checkout and local dataset material
appworld/
appworld_data/
data/
models/

# Runtime trajectories, checkpoints, branch outputs, and reports
results/
artifacts/
# Keep source modules named "results"; only runtime result directories are ignored.
!controller_agent/results/
!controller_agent/results/*.py
!controller_agent/results/reviewer.html
outputs/
checkpoints/
branch_runs/
trajectories/
cache/
logs/
*.log
RESULTS_STRUCTURE*.md

# Temporary/debug archive and generated packaging metadata
scripts/archive/
*.egg-info/
build/
dist/

# Local task allocation files are not controller source or tests
task_ids/

# OS/editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Documentation is source; generated experiments belong under artifacts/.
